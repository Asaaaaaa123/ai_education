# Copy to `.env` in the project root for production `docker compose up` (ports only).
# Clerk keys: set in backend/.env and frontend/.env (Docker Compose loads those files).

# --- Ports (host) ---
FRONTEND_PORT=80
BACKEND_PORT=8080

# --- Clerk (set real keys in backend/.env and frontend/.env, not here) ---
# CLERK_SECRET_KEY=sk_test_...
# REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Production URLs (replace with your server IP or domain) ---
# Must match where users open the app in the browser (Clerk azp + CORS)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3333,http://127.0.0.1:3333
CLERK_AUTHORIZED_PARTIES=http://localhost,http://127.0.0.1,http://localhost:3333,http://127.0.0.1:3333

# Example with HTTPS domain:
# ALLOWED_ORIGINS=https://education.example.com
# CLERK_AUTHORIZED_PARTIES=https://education.example.com
