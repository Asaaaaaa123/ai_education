# Clerk — https://dashboard.clerk.com (publishable key only; safe in the browser bundle)
# Create React App requires the REACT_APP_ prefix (not NEXT_PUBLIC_*).
# Copy to `frontend/.env` and replace the placeholder.
# Must match the same Clerk application as backend `CLERK_SECRET_KEY`.
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key: put in `backend/.env` and repo root `.env` (Docker), never here.

# Optional: API base (defaults work for localhost dev with Docker)
# REACT_APP_API_URL=http://localhost:8080
# PORT=3333
